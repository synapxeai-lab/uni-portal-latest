# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
.vscode/
.idea/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.*
!.env.example
!.env.sample

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma generated client
/src/generated/

# local file storage (development only - see src/lib/storage)
/storage/uploads/

# ui-check screenshots
/tools/ui-check/out/

# express/react workspaces
/server/src/generated/
/server/storage/
/server/dist/
/client/dist/

# legacy database dumps used by the data migration (contain personal data)
/migration/dumps/
