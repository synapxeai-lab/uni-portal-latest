# Local development needs no .env - docker-compose.yml sets everything.
# These are the API server's settings for other environments (see
# server/src/config/env.ts for the full list and defaults).

# PostgreSQL connection string.
DATABASE_URL="postgresql://portal:portal_password@localhost:5440/portal_dev?schema=public"

# HS256 secret for session JWTs - at least 32 random characters.
# Generate one with: openssl rand -hex 32
JWT_SECRET="replace-me-with-a-long-random-string-of-32-plus-chars"

PORT=4000

# Where uploaded files are stored (mount a persistent volume here).
# The production image defaults to /data/uploads.
STORAGE_ROOT=""

# Serve the built React app from the API server (set by the Dockerfile).
SERVE_CLIENT_DIR=""

# Session cookie Secure flag - defaults to true in production. Set "false"
# only to try a production build over plain http.
# COOKIE_SECURE="false"

# Run the scheduled-content publisher in this instance (default true). When
# running several instances, set "false" on all but one.
# SCHEDULED_PUBLISH_WORKER="false"

# Requests slower than this (ms) are logged as warnings.
SLOW_REQUEST_MS=100

# Encrypts the copy of each password admins can view on the Users page.
# Falls back to JWT_SECRET. Changing it makes stored copies unviewable
# (sign-in keeps working).
# PASSWORD_ENC_KEY="another-long-random-string"

# Only for `npm run db:import-legacy` (see README): the legacy databases and
# the University Portal's PASSWORD_ENC_KEY (or JWT_SECRET).
# LEGACY_UP_URL="postgresql://portal:portal_password@postgres:5432/legacy_up"
# LEGACY_GCR_URL="postgresql://portal:portal_password@postgres:5432/legacy_gcr"
# LEGACY_UP_PASSWORD_ENC_KEY=""
