{
  "name": "@portal/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "prisma generate && node scripts/build.mjs",
    "start": "node dist/index.js",
    "create-admin": "node dist/create-admin.js",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "seed": "prisma db seed",
    "seed:users": "tsx prisma/seed-users.ts",
    "latency": "tsx scripts/latency.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:import-legacy": "tsx scripts/import-legacy.ts"
  },
  "dependencies": {
    "@portal/shared": "*",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "pg": "^8.16.3",
    "prisma": "^7.8.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "esbuild": "^0.25.10",
    "tsx": "^4.20.6",
    "vitest": "^3.2.4",
    "typescript": "^5.9.3"
  }
}
